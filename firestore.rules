rules_version = '2';

// 명함 문서는 두 겹으로 나뉜다.
//
//   cards/{id}                 공개 문서. "공개"로 설정한 항목만 들어 있어 누구나 읽을 수 있다.
//   cards/{id}/private/card    입력 원본과 비밀번호. 소유자만 접근한다.
//
// Firestore 규칙은 필드 단위로 가릴 수 없기 때문에, 공개 문서에 비공개
// 항목을 넣어두고 화면에서만 숨기는 방식은 통하지 않는다. 그래서 저장
// 단계에서 아예 분리한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 키 목록은 PublicCard 타입(src/types/cardType.ts)과 정확히 일치해야 한다.
    // 한쪽에만 필드를 더하면 hasOnly 가 막아 생성이 통째로 거부된다.
    //
    // 상한값은 앱이 실제로 만들어내는 최대치에 여유를 둔 것이다.
    // 기본 항목 11개 + 추가 항목 5개 -> entries 최대 16개
    // values 키는 항목당 최대 3개(본문 / 직접입력 제목 / 내용) -> 최대 30개 남짓
    function isCardShape() {
      let card = request.resource.data;

      return card.keys().hasOnly(['serialNumber', 'uid', 'createdAt', 'entries', 'inShuffle', 'search', 'hasPhoto'])
        && card.serialNumber is string
        && card.serialNumber.size() <= 32
        && card.createdAt is timestamp
        && card.entries is list
        && card.entries.size() <= 30
        && card.inShuffle is bool
        && card.search is map
        && card.search.keys().size() <= 60
        && card.hasPhoto is bool;
    }

    /**
     * 셔플/검색 질의.
     *
     * 셔플에 노출하기로 한 명함만, 한 번에 CANDIDATE_LIMIT 개까지 본다.
     * resource.data 를 참조하므로 클라이언트 질의에도 같은 조건이 없으면
     * Firestore 가 질의 자체를 거부한다.
     *
     * 조건은 전부 "같음" 으로만 넘어오기 때문에 Firestore 가 단일 필드
     * 색인을 합쳐 처리한다. 조건을 몇 개 조합하든 복합 색인이 필요 없다.
     */
    function isShuffleQuery() {
      return request.query.limit <= 50 && resource.data.inShuffle == true;
    }

    // 사진은 Storage 대신 데이터 URL 로 담는다. 문서 한도를 넘지 않도록
    // 클라이언트에서 줄이고, 여기서도 같은 상한으로 한 번 더 막는다.
    function isPhotoShape() {
      let photo = request.resource.data;

      return photo.keys().hasOnly(['uid', 'dataUrl'])
        && photo.dataUrl is string
        && photo.dataUrl.size() <= 150000
        && photo.dataUrl.matches('data:image/.*');
    }

    /**
     * 길잡이가 자기 명함을 가리키는지 확인한다.
     *
     * 명함 문서를 직접 읽어 일련번호와 소유자가 맞는지 본다. 이것이
     * 없으면 남의 일련번호를 엉뚱한 곳으로 돌려놓을 수 있다.
     */
    function pointsAtItsCard(serial) {
      let pointer = request.resource.data;
      let card = get(/databases/$(database)/documents/$(pointer.collection)/$(pointer.cardId)).data;

      return card.serialNumber == serial && card.uid == pointer.uid;
    }

    function isPrivateCardShape() {
      let card = request.resource.data;

      return card.keys().hasOnly(['uid', 'values', 'isPublic', 'password'])
        && card.values is map
        && card.values.keys().size() <= 60
        && card.isPublic is map
        && card.isPublic.keys().size() <= 60
        && (!card.keys().hasAny(['password']) || card.password is map);
    }

    // ---------------------------------------------------------------- 회원 명함
    match /cards/{cardId} {
      allow get: if true;

      /**
       * 목록 조회는 두 가지만 연다.
       *
       * 소유자 조회는 resource.data.uid 를 참조하므로, 클라이언트 질의에도
       * where("uid", "==", 내 uid) 가 없으면 Firestore 가 질의를 거부한다.
       * 즉 남의 명함은 애초에 목록에 섞일 수 없다.
       */
      allow list: if isShuffleQuery()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && isCardShape()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // 만든 시각과 일련번호는 바뀌지 않는다. 이미 공유된 값이기 때문이다.
      allow update: if request.auth != null
        && isCardShape()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.serialNumber == resource.data.serialNumber;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // 원본은 소유자만 본다.
      //
      // 앱이 쓰는 경로는 이 문서 하나뿐이라 경로를 고정한다. 재귀 와일드카드로
      // 열어두면 남의 명함 하위에 임의 경로를 만들 수 있다.
      //
      // 명함 문서와 같은 배치로 생성되므로 부모를 get() 할 수 없다.
      // 대신 uid 를 이 문서에도 두고 그것으로 판단한다.
      match /private/card {
        allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;

        allow create: if request.auth != null
          && isPrivateCardShape()
          && request.resource.data.uid == request.auth.uid;

        // create 와 같은 형태 검증을 걸고 uid 도 고정한다.
        // 이게 없으면 한 번 만든 뒤 임의의 내용으로 덮어쓸 수 있다.
        allow update: if request.auth != null
          && isPrivateCardShape()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;

        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }

      // 사진은 명함과 함께 공개된다. 수정/삭제는 소유자만 한다.
      // 명함 문서와 같은 배치로 만들어지므로 부모를 get() 할 수 없다.
      // private 문서와 마찬가지로 uid 를 여기에도 두고 그것으로 판단한다.
      match /photo/data {
        allow get: if true;
        allow list: if false;

        allow create: if request.auth != null
          && isPhotoShape()
          && request.resource.data.uid == request.auth.uid;

        allow update: if request.auth != null
          && isPhotoShape()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;

        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    /**
     * 일련번호 -> 명함 문서 길잡이.
     *
     * 목록 조회는 규칙이 질의에 담긴 값을 알 수 없어, serialNumber 로
     * 거르는 것을 허용할 방법이 없다. 그래서 일련번호 자체를 문서
     * id 로 삼아 get 한 번으로 찾아간다.
     *
     * 일련번호는 32^10 가지라 찍어서 맞힐 수 없고, 목록 조회는 막아
     * 훑어 내려갈 수도 없다.
     */
    match /serials/{serial} {
      allow get: if true;
      allow list: if false;

      /*
       * 이미 있는 문서면 create 가 실패하므로 남의 번호를 덮어쓸 수 없고,
       * 가리키는 명함이 실제로 그 번호를 달고 있어야 만들 수 있다.
       *
       * 명함이 먼저 있어야 하므로 길잡이는 명함을 만든 뒤에 따로 쓴다.
       * 같은 배치에 넣으면 이 검사 시점에 명함이 아직 없다.
       */
      allow create: if request.resource.data.keys().hasOnly(['collection', 'cardId', 'uid'])
        && request.resource.data.collection in ['cards', 'guestCards']
        && request.resource.data.cardId is string
        && request.resource.data.cardId.size() <= 64
        && pointsAtItsCard(serial);

      allow update: if false;
      // 명함을 지울 때 길잡이도 함께 지운다. 비회원 명함은 지울 수 없다.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------- 비회원 명함
    match /guestCards/{cardId} {
      allow get: if true;
      allow list: if isShuffleQuery();

      // 회원가입 없이 만들 수 있어야 하므로 인증을 요구하지 않는다.
      // 대량 생성 방지는 App Check 또는 Cloud Functions 가 필요하다. (#49)
      allow create: if isCardShape()
        && request.resource.data.uid == null
        && request.resource.data.createdAt == request.time;

      // 비밀번호 확인은 서버에서만 할 수 있다. 그때까지 수정/삭제는 막아둔다.
      allow update, delete: if false;

      match /private/card {
        // 비밀번호가 들어 있으므로 클라이언트에는 절대 내려보내지 않는다.
        allow read: if false;
        allow create: if isPrivateCardShape() && request.resource.data.uid == null;
        allow update, delete: if false;
      }

      match /photo/data {
        allow get: if true;
        allow list: if false;
        allow create: if isPhotoShape() && request.resource.data.uid == null;
        // 비회원 명함은 비밀번호 확인이 서버에서만 가능해 수정/삭제를 막아둔다.
        allow update, delete: if false;
      }
    }
  }
}
