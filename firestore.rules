rules_version = '2';

// 명함 문서는 두 겹으로 나뉜다.
//
//   cards/{id}                 공개 문서. "공개"로 설정한 항목만 들어 있어 누구나 읽을 수 있다.
//   cards/{id}/private/card    입력 원본과 비밀번호. 소유자만 접근한다.
//
// Firestore 규칙은 필드 단위로 가릴 수 없기 때문에, 공개 문서에 비공개
// 항목을 넣어두고 화면에서만 숨기는 방식은 통하지 않는다. 그래서 저장
// 단계에서 아예 분리한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 상한값은 앱이 실제로 만들어내는 최대치에 여유를 둔 것이다.
    // 기본 항목 11개 + 추가 항목 5개 -> entries 최대 16개
    // values 키는 항목당 최대 3개(본문 / 직접입력 제목 / 내용) -> 최대 30개 남짓
    function isCardShape() {
      let card = request.resource.data;

      return card.keys().hasOnly(['serialNumber', 'uid', 'createdAt', 'entries', 'shuffle'])
        && card.serialNumber is string
        && card.serialNumber.size() <= 32
        && card.createdAt is timestamp
        && card.entries is list
        && card.entries.size() <= 30
        && isShuffleShape(card.shuffle);
    }

    // 랜덤 셔플에 쓰는 메타데이터. key 는 무작위 추출용 0~1 난수다.
    function isShuffleShape(shuffle) {
      return shuffle.keys().hasOnly(['enabled', 'key', 'gender', 'mbti'])
        && shuffle.enabled is bool
        && shuffle.key is number
        && shuffle.key >= 0
        && shuffle.key < 1;
    }

    /**
     * 셔플은 한 장씩만 뽑고, 셔플에 노출하기로 한 명함만 대상이다.
     * resource.data 를 참조하므로 클라이언트 질의에도 같은 조건이 없으면
     * Firestore 가 질의 자체를 거부한다.
     */
    function isShuffleQuery() {
      return request.query.limit <= 1 && resource.data.shuffle.enabled == true;
    }

    function isPrivateCardShape() {
      let card = request.resource.data;

      return card.keys().hasOnly(['uid', 'values', 'isPublic', 'password'])
        && card.values is map
        && card.values.keys().size() <= 60
        && card.isPublic is map
        && card.isPublic.keys().size() <= 60
        && (!card.keys().hasAny(['password']) || card.password is map);
    }

    // ---------------------------------------------------------------- 회원 명함
    match /cards/{cardId} {
      allow get: if true;
      // 목록 조회는 셔플에만 열어둔다. 마이페이지를 붙일 때 다시 검토한다.
      allow list: if isShuffleQuery();

      allow create: if request.auth != null
        && isCardShape()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && isCardShape()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // 원본은 소유자만 본다.
      //
      // 앱이 쓰는 경로는 이 문서 하나뿐이라 경로를 고정한다. 재귀 와일드카드로
      // 열어두면 남의 명함 하위에 임의 경로를 만들 수 있다.
      //
      // 명함 문서와 같은 배치로 생성되므로 부모를 get() 할 수 없다.
      // 대신 uid 를 이 문서에도 두고 그것으로 판단한다.
      match /private/card {
        allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;

        allow create: if request.auth != null
          && isPrivateCardShape()
          && request.resource.data.uid == request.auth.uid;

        // create 와 같은 형태 검증을 걸고 uid 도 고정한다.
        // 이게 없으면 한 번 만든 뒤 임의의 내용으로 덮어쓸 수 있다.
        allow update: if request.auth != null
          && isPrivateCardShape()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;

        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------- 비회원 명함
    match /guestCards/{cardId} {
      allow get: if true;
      allow list: if isShuffleQuery();

      // 회원가입 없이 만들 수 있어야 하므로 인증을 요구하지 않는다.
      // 대량 생성 방지는 App Check 또는 Cloud Functions 가 필요하다. (#30)
      allow create: if isCardShape()
        && request.resource.data.uid == null
        && request.resource.data.createdAt == request.time;

      // 비밀번호 확인은 서버에서만 할 수 있다. 그때까지 수정/삭제는 막아둔다.
      allow update, delete: if false;

      match /private/card {
        // 비밀번호가 들어 있으므로 클라이언트에는 절대 내려보내지 않는다.
        allow read: if false;
        allow create: if isPrivateCardShape() && request.resource.data.uid == null;
        allow update, delete: if false;
      }
    }
  }
}
